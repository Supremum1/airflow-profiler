{
  "uid": "airflow-cgroups",
  "title": "Airflow Resources",
  "tags": [
    "airflow",
    "benchmark"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Executor tasks and slots",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "airflow_executor_queued_tasks",
          "legendFormat": "queued"
        },
        {
          "refId": "B",
          "expr": "airflow_executor_running_tasks",
          "legendFormat": "running"
        },
        {
          "refId": "C",
          "expr": "airflow_executor_open_slots",
          "legendFormat": "open slots"
        }
      ]
    },
    {
      "id": 2,
      "title": "Scheduler heartbeat and DAG import errors",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(airflow_scheduler_heartbeat_total[1m])",
          "legendFormat": "heartbeats / minute"
        },
        {
          "refId": "B",
          "expr": "airflow_dag_processing_import_errors",
          "legendFormat": "import errors"
        }
      ]
    },
    {
      "id": 3,
      "title": "CPU cores by service",
      "type": "timeseries",
      "description": "Worker runs task processes; scheduler plans and queues them. Redis is the Celery broker. Before the Celery migration, scheduler also included task processes.",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (rate(container_cpu_usage_seconds_total{job=\"airflow-cgroups\"}[6s]) and on(service,id) (time()-bench_resource_last_sample_seconds{job=\"airflow-cgroups\"}<3))",
          "interval": "2s",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Working set by service",
      "type": "timeseries",
      "description": "Celery worker memory includes the worker pool and all active task subprocesses.",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (service) (container_memory_working_set_bytes{job=\"airflow-cgroups\"} and on(service,id) (time()-bench_resource_last_sample_seconds{job=\"airflow-cgroups\"}<3))",
          "interval": "2s",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Airflow service logs",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=~\"scheduler|worker|api|dag-processor|metadata|redis\"}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Scheduler loop p95",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(airflow_scheduler_loop_seconds_bucket[1m])))",
          "legendFormat": "loop p95"
        }
      ]
    },
    {
      "id": 7,
      "title": "Metadata PostgreSQL connections",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_stat_database_numbackends{job=\"metadata-postgres\",datname=\"bench\"}",
          "legendFormat": "active connections"
        }
      ]
    }
  ]
}
